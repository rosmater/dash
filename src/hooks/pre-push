#!/bin/bash
# t6157u (Rost 12.11): даш пушится только из /workspace/dash-gh и только не из отставшей копии.
# Установка: ln -sf ../../src/hooks/pre-push .git/hooks/pre-push   (в /workspace/dash-gh)
top=$(realpath "$(git rev-parse --show-toplevel)")
url=$(git remote get-url origin 2>/dev/null)
if [ "$top" != "$(realpath /workspace/dash-gh)" ] || [[ "$url" != *rosmater/dash* ]]; then
  echo "pre-push FAIL (t6157u): пушить даш можно только из /workspace/dash-gh, а это $top ($url)"; exit 1
fi
timeout 25 git fetch -q origin main 2>/dev/null || echo 'pre-push: fetch не прошёл — проверяю по последнему известному origin/main'
outs='^(index\.html|variant-[abc]\.html|helper\.html|assistant\.html|data\.enc\.json|data-asst\.enc\.json|data-test-ma\.enc\.json)$'
base_file="$(git rev-parse --git-dir)/dash-build-base"
while read -r lref lsha rref rsha; do
  [ "$rref" = "refs/heads/main" ] || continue
  [ "$lsha" = "0000000000000000000000000000000000000000" ] && continue
  if ! git merge-base --is-ancestor origin/main "$lsha"; then
    echo "pre-push FAIL (t6157u): локальный main не содержит origin/main — сначала git pull --rebase --autostash origin main, потом bash src/build.sh"; exit 1
  fi
  # Если в пуше меняются собранные файлы — сборка должна быть сделана на свежем src/
  if git diff --name-only origin/main "$lsha" | grep -Eq "$outs"; then
    if [ -s "$base_file" ]; then
      b=$(cat "$base_file")
      if git cat-file -e "$b^{commit}" 2>/dev/null && [ -n "$(git rev-list -1 "$b..origin/main" -- src/)" ]; then
        echo "pre-push FAIL (t6157u): даш собран на базе ${b:0:8}, а в origin/main после неё менялся src/ (чужие правки) — пересобери: bash src/build.sh, закоммить и пушь снова"; exit 1
      fi
    else
      echo 'pre-push: нет .git/dash-build-base (сборка не через src/build.sh?) — пропускаю проверку свежести сборки'
    fi
  fi
done
exit 0
