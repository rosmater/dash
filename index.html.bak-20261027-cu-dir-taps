function maUndo(btn){const O=oqLS(),k=btn.dataset.k,e=O[k];delete O[k];oqSave(O);render();if(e)maToast('↩ '+k+' вернул на даш (только у тебя в браузере). Если бот уже сделал resolve — скажи ему ma_q.py reopen '+k);}
function maChk(b){const C=b._chk||[];if(!C.length)return '';return `<details class="okfold"><summary>☑ На проверке (${C.length})</summary>${C.map(([k,e])=>`<div class="bq" style="display:flex;gap:8px;align-items:center;opacity:.75"><span style="flex:1"><s>${esc(e.q)}</s> <span class="note" style="font-size:10px">(${esc(k)} · ✓ ${esc(e.t)})</span></span><button class="qchat" data-k="${esc(k)}" onclick="event.stopPropagation();maUndo(this)" title="Вернуть вопрос — ✓ нажат зря">↩ вернуть</button></div>`).join('')}<div class="note">скрыто у тебя сразу; бот проверяет и убирает из общей базы; если ✓ ложный — вопрос вернётся после пересборки</div></details>`}
/* Rost 26.10: у каждого бота — свёрнутые «Рутины · ок» (упавшие видны сразу) и отдельно свёрнутые «Задачи в очереди»; решённое не показываем вообще */
function maRtQ(b){const R=b.routines||[],F=R.filter(r=>r.st==='fail'),O=R.filter(r=>r.st!=='fail'),Q=b.queue||[];let h='';
 const rli=r=>`<li>${r.st==='fail'?'🔴':r.st==='new'?'⚪':'🟢'} <b>${esc(r.name)}</b> <span class="note" style="font-size:10px" title="последний запуск">(${r.last?esc(r.last):'посл. запуск: нет данных'})</span> <span class="note">· ${esc(r.sched||'')}${r.note?' · '+esc(r.note):''}${r.st==='new'?' · ещё не запускалась':''}</span></li>`;
 if(F.length)h+=`<div class="bq red" style="margin:6px 0">🔴 Рутина упала: ${F.map(r=>esc(r.name)+(r.note?' <span class="note">('+esc(r.note)+')</span>':'')).join('; ')}</div>`;
 if(O.length)h+=`<details class="okfold"><summary>🟢 Рутины · ок (${O.length})</summary><ul>${O.map(rli).join('')}</ul><div class="note">источник: ${esc(b.routines_src||'')}</div></details>`;
 else if(b.routines_note)h+=`<div class="note">⚙️ Рутины: ${esc(b.routines_note)}</div>`;
 if(Q.length)h+=`<details class="okfold"><summary>📋 Задачи в очереди (${Q.length})</summary><ul>${Q.map(q=>`<li><span class="pill ${/blocked|waiting user|rost/i.test(q.st)?'st-open':'p-normal'}">${esc(q.st)}</span> ${esc(q.t)}</li>`).join('')}</ul><div class="note">источник: ${esc(b.queue_src||'')}</div></details>`;
 return h}
function botsTab(d){const B=d.bots||[];const open=B.reduce((a,b)=>a+(b.qs||[]).filter(q=>!q.answered).length,0);
 /* Rost 26.10: по каждому боту — выпадающий список: статус-чип + вопросы + задачи CU (for check) со статусами; 🟡 = свежие отчёты/обновления сегодня */
 const ST={attention:['🔴 Требует внимания','st-open'],working:['🔵 В работе','p-normal'],ok:['🟢 Всё ок','st-ans'],nodata:['⚪ Нет данных','p-low']};const u=t=>(d.cu_base||'https://rosmater.github.io/cu/?t=')+t;
 const tot=B.reduce((a,b)=>a+(b.new_count||0),0);
 const one=(b,bi,inner)=>{const qs=(b.qs||[]).map((q,i)=>[q,i]),red=qs.filter(([q])=>q.st==='red'&&!q.answered),gr=qs.filter(([q])=>!(q.st==='red'&&!q.answered)&&!q.wait),wq=qs.filter(([q])=>q.wait&&!(q.st==='red'&&!q.answered)),WQ=b.waiting||[],wn=wq.length+WQ.length,T=inner?[]:(b.tasks||[]);const st=ST[b.status]||ST.ok;
  const tli=t=>`<li><a target="_blank" rel="noopener" href="${u(t.id)}">${esc(t.name)}</a> <span class="pill p-normal">${esc(t.status||'')}</span>${t.new?' <span class="ydot" title="обновлено сегодня — новый отчёт"></span>':''} <span class="note">· ${esc(t.list||'')} · обн. ${esc((t.updated||'').slice(5))}</span>${maLink(b.name,b.link,'Ассистенты · боты',t.id+' «'+t.name+'» (for check)')}</li>`;
  return `<details class="${inner?'':'card '}mrow" style="margin-bottom:10px" ${b.status==='attention'&&!inner?'open':''}><summary><b>${esc(inner?b.name.replace(/^Коучинг · /,''):b.name)}</b><span class="pill ${st[1]}">${st[0]}</span>${b.new_count?`<span class="pill" style="background:#fef9c3;color:#854d0e">🟡 ${b.new_count} новых</span>`:''}${wn?`<span class="pill" style="background:#e0f2fe;color:#075985">⏳ ждём ответ ${wn}</span>`:''}<span class="note">${(b.qs||[]).filter(q=>!q.answered).length} вопр. · ${T.length} задач</span>${b.link?`<a class="st" style="margin-left:auto" href="${esc(b.link)}" onclick="event.stopPropagation()">открыть чат ↗</a>`:''}</summary><div class="mbody">
  ${b.nodata?`<div class="empty">${esc(b.nodata)}</div>`:''}${red.map(([q,i])=>maQ(b,q,bi,i)).join('')}
  ${(()=>{const pl=gr.filter(([q])=>!q.grp),G={};gr.filter(([q])=>q.grp).forEach(x=>(G[x[0].grp]=G[x[0].grp]||[]).push(x));return (pl.length?`<details class="okfold" open><summary>Вопросы / отчёты (${pl.length})</summary>${pl.map(([q,i])=>maQ(b,q,bi,i)).join('')}</details>`:'')+Object.entries(G).map(([g,L])=>`<details class="okfold"><summary>${esc(g)} (${L.length})</summary>${L.map(([q,i])=>maQ(b,q,bi,i)).join('')}</details>`).join('')})()}${wn?`<details class="okfold"><summary>⏳ Ждём ответ (${wn})</summary>${wq.map(([q,i])=>maQ(b,q,bi,i)).join('')}${WQ.length?`<ul>${WQ.map(w=>`<li><span class="pill p-normal">${esc(w.st)}</span> ${esc(w.t)}${maLink(b.name,b.link,'Ассистенты · ждём ответ',w.t)}</li>`).join('')}</ul>`:''}<div class="note">от кого ждём ответ (люди/чаты), не вопросы к тебе</div></details>`:''}${b.watch?`<div class="note">👁 ${esc(b.watch)}</div>`:''}${b.owner_note?`<div class="note">ℹ️ ${esc(b.owner_note)}</div>`:''}
  ${maChk(b)}${inner?'':maRtQ(b)}
  ${T.length?`<details class="okfold"><summary>Задачи ClickUp · for check (${T.length}${T.filter(t=>t.new).length?', 🟡 '+T.filter(t=>t.new).length+' сегодня':''})</summary><ul>${T.map(tli).join('')}</ul></details>`:''}
  ${!b.nodata&&!qs.length&&!T.length&&!(b.routines||[]).length&&!(b.queue||[]).length&&!wn?'<div class="empty">🟢 Открытых вопросов и задач нет</div>':''}</div></details>`};
 /* Rost 26.10: Коучинг = ОДИН блок со списком людей, у кого проблемы с ботом (не карточка на каждого) */
 const CO=B.map((b,bi)=>[b,bi]).filter(([b])=>b.coach),bad=CO.filter(([b])=>(b.qs||[]).some(q=>!q.answered&&!q.wait)),okc=CO.filter(x=>!bad.includes(x));
 const coH=bad.length?/* Rost 26.10 20:13: блок Коучинг только если у бота есть вопрос/внимание; задачи — во вкладке Коучинг */`<details class="card mrow" style="margin-bottom:10px"><summary><b>🤝 Коучинг</b><span class="pill ${bad.length?'st-open':'st-ans'}">${bad.length?'🔴 проблемы у '+bad.length:'🟢 всё ок'}</span><span class="note">${bad.length?bad.length+' с вопросом · ':''}${CO.length} человек</span></summary><div class="mbody">${bad.map(([b,bi])=>one(b,bi,true)).join('')}${okc.length?`<details class="okfold"><summary>🟢 Без вопросов (${okc.length})</summary><ul>${okc.map(([b])=>`<li>${esc(b.name.replace(/^Коучинг · /,''))}</li>`).join('')}</ul></details>`:''}</div></details>`:'';
 /* Rost 27.10: в «Ассистенты · боты» блоки с сообщениями мессенджеров скрыты (maCUBots «Сообщения ClickUp от ботов» убран) — сверху только 📊 Монитор мессенджеров (вочеры живы + последний сигнал) */
 const MD=Dash.D.directions.find(x=>x.kind==='msgs'),MON=MD?maMonitor(MD,(MD.messengers||[]).map(g=>({sphere:g.sphere,rows:[...(g.rows||[])]}))):'';
 $('#main').innerHTML=maHead(d,open+' открытых вопросов · 🟡 '+tot+' новых отчётов')+MON+attnHTML(d)+B.map((b,bi)=>b.coach?'':one(b,bi)).join('')+coH+`
  <p class="note">🔴 встало / нужен Rost · 🔵 в работе · 🟢 всё ок · ⚪ нет данных · 🟡 = свежие отчёты (вопросы с new + задачи CU, обновлённые сегодня). Источник: последние сообщения ботов (аудит 26.10 ~19:35 Bogotá) + ClickUp for check на Rost. «💬 открыть чат» у каждого вопроса — открывает чат ответственного бота с этим вопросом в поле ввода (<code>grokbot://app/v1/prompt?id=…&amp;text=…</code>, отправляешь сам); если приложение ещё без prompt-ссылок — просто открывает чат бота, а вопрос лежит в буфере (Ctrl/⌘+V). <b>✓</b> = решено: вопрос сразу скрыт и уходит на проверку (☑ На проверке, ↩ вернуть) — прямо на даше, чат не открывается. <b>↻</b> = перечитать свежие данные — тоже на месте. В чат бота ведёт только «💬 открыть чат» / «открыть чат ↗». Вопросы — снимок сборки ${esc((d.oq&&d.oq.built)||'')}, общая база ботов: /workspace/queue/ma_open_questions.json. Коучинг/«Мама»: только если у бота есть вопрос (задачи — во вкладке Коучинг); TG «Общение ботов» — любое новое → 🔴 сверху у «Мама».</p>`}
